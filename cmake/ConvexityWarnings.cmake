function(convexity_enable_warnings target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive-)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
endfunction()

function(convexity_enable_sanitizers target)
    if(NOT CONVEXITY_ENABLE_SANITIZERS)
        return()
    endif()

    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE -fsanitize=address,undefined)
    elseif(MSVC)
        message(WARNING "CONVEXITY_ENABLE_SANITIZERS is not configured for MSVC; ignoring it for ${target}")
    else()
        message(WARNING "CONVEXITY_ENABLE_SANITIZERS is not supported by compiler ${CMAKE_CXX_COMPILER_ID}")
    endif()
endfunction()
